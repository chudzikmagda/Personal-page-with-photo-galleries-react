{
  "name": "photography",
  "version": "2.0.0",
  "homepage": "https://magdachudzik.pl/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run create-gallery-metadata && react-router build && cp -r ./php ./build/client/php && cp .env ./build/client/.env && cp .htaccess ./build/client/.htaccess",
    "build:ci": "npm run create-gallery-metadata && react-router build",
    "start": "serve -s build/client",
    "create-gallery-metadata": "node build-gallery-metadata.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,scss}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,scss}\""
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@react-router/node": "^8",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-ga4": "^3.0.1",
    "react-hotjar": "^6.3.1",
    "react-i18next": "^17.0.13",
    "react-router": "^8",
    "react-transition-group": "^4.4.5",
    "reset-css": "^5.0.2",
    "swiper": "^14.2.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^8",
    "@rolldown/plugin-babel": "^0.1.8",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.3",
    "vite-plugin-svgr": "^4.5.0"
  }
